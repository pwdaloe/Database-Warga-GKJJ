# Database terpisah dari aplikasi jemaat (gkjj_kegiatan), server PostgreSQL yang sama boleh
DATABASE_URL="postgresql://gkjj:gkjj_dev_password@localhost:5432/gkjj_kegiatan"

PORT=4200
NODE_ENV=development

# JWT — ganti dengan acak panjang di produksi (openssl rand -hex 32). JANGAN sama dengan JWT_SECRET aplikasi jemaat.
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter"
JWT_EXPIRES_IN="12h"

# CORS: alamat web kegiatan
CORS_ORIGIN="http://localhost:3200"

# Password awal untuk `npm run db:seed` (wajib, minimal 12 karakter). Jangan di-commit.
SEED_ADMIN_PASSWORD=""
# Hanya untuk `npm run db:seed:contoh` (akun contoh per pengurus UPK di lokal)
SEED_CONTOH_PASSWORD=""
