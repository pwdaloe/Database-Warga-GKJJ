// ============================================================
// Prisma Schema — Database Warga GKJJ
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MASTER DATA
// ============================================================

// ── MASTER DATA ─────────────────────────────────────────────
model ActivityLog {
  id           BigInt   @id @default(autoincrement())
  userId       Int?     @map("user_id")
  userNama     String?  @map("user_nama") @db.VarChar(150)
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(500)
  statusCode   Int      @map("status_code")
  errorMessage String?  @map("error_message") @db.Text
  bodySnapshot Json?    @map("body_snapshot")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  durasiMs     Int?     @map("durasi_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([statusCode])
  @@map("activity_log")
}

model MasterKelurahan {
  id        Int     @id @default(autoincrement())
  nama      String  @db.VarChar(100)
  kecamatan String  @db.VarChar(100)
  kota      String  @db.VarChar(100)
  kodePos   String? @map("kode_pos") @db.VarChar(10)

  @@index([nama])
  @@map("master_kelurahan")
}

model KomisiConfig {
  id      Int    @id @default(autoincrement())
  nama    String @db.VarChar(100)
  minUsia Int    @map("min_usia")
  maxUsia Int?   @map("max_usia")
  urutan  Int    @default(0)
  warna   String @default("#6366f1") @db.VarChar(20)

  @@map("komisi_config")
}

model Wilayah {
  id         Int      @id @default(autoincrement())
  kode       String   @unique @db.VarChar(5)
  nama       String   @db.VarChar(100)
  keterangan String?  @db.Text
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  kelompoks Kelompok[]

  @@map("wilayah")
}

model Kelompok {
  id                Int      @id @default(autoincrement())
  wilayahId         Int      @map("wilayah_id")
  kode              String   @unique @db.VarChar(5)
  nama              String   @db.VarChar(100)
  penatamaId        Int?     @map("penatua_id")
  penatua_nama_temp String?  @db.VarChar(150)
  aktif             Boolean  @default(true)
  keterangan        String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  wilayah   Wilayah    @relation(fields: [wilayahId], references: [id])
  penatua   Warga?     @relation("KelompokPenatua", fields: [penatamaId], references: [id])
  keluargas Keluarga[]
  users     User[]

  @@map("kelompok")
}

// ============================================================
// DATA JEMAAT
// ============================================================

model Keluarga {
  id            Int            @id @default(autoincrement())
  nomorKeluarga String?        @unique @map("nomor_keluarga") @db.VarChar(20)
  kelompokId    Int?           @map("kelompok_id")
  alamat        String?        @db.Text
  rt            String?        @db.VarChar(5)
  rw            String?        @db.VarChar(5)
  kelurahan     String?        @db.VarChar(100)
  kecamatan     String?        @db.VarChar(100)
  kota          String?        @db.VarChar(100)
  kodePos       String?        @map("kode_pos") @db.VarChar(10)
  teleponRumah  String?        @map("telepon_rumah") @db.VarChar(20)
  status        StatusKeluarga @default(AKTIF)
  dataStatus    DataStatus     @default(DRAFT) @map("data_status")
  catatan       String?        @db.Text
  createdBy     Int?           @map("created_by")
  updatedBy     Int?           @map("updated_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  kepalakeluargaId Int? @map("kepala_keluarga_id")

  kelompok       Kelompok? @relation(fields: [kelompokId], references: [id])
  kepalaKeluarga Warga?    @relation("KeluargaKepala", fields: [kepalakeluargaId], references: [id])
  createdByUser  User?     @relation("KeluargaCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?     @relation("KeluargaUpdatedBy", fields: [updatedBy], references: [id])
  wargas         Warga[]

  @@index([kelompokId])
  @@map("keluarga")
}

model Warga {
  id                       Int                 @id @default(autoincrement())
  keluargaId               Int?                @map("keluarga_id")
  nomorAnggota             String?             @unique @map("nomor_anggota") @db.VarChar(20)
  nomorInduk               String?             @unique @map("nomor_induk") @db.VarChar(30)
  namaLengkap              String              @map("nama_lengkap") @db.VarChar(150)
  namaPanggilan            String?             @map("nama_panggilan") @db.VarChar(50)
  jenisKelamin             JenisKelamin        @map("jenis_kelamin")
  tempatLahir              String?             @map("tempat_lahir") @db.VarChar(100)
  tanggalLahir             DateTime?           @map("tanggal_lahir") @db.Date
  nik                      String?             @unique @db.VarChar(64) // encrypted AES-256
  golonganDarah            GolonganDarah?      @map("golongan_darah")
  fotoUrl                  String?             @map("foto_url") @db.Text
  statusKeluarga           StatusDalamKeluarga @default(LAINNYA) @map("status_keluarga")
  statusKeanggotaan        StatusKeanggotaan   @default(AKTIF) @map("status_keanggotaan")
  sudahBaptis              Boolean             @default(false) @map("sudah_baptis")
  tanggalBaptis            DateTime?           @map("tanggal_baptis") @db.Date
  tempatBaptis             String?             @map("tempat_baptis") @db.VarChar(150)
  sudahSidi                Boolean             @default(false) @map("sudah_sidi")
  nomorSidi                String?             @map("nomor_sidi") @db.VarChar(30)
  tanggalSidi              DateTime?           @map("tanggal_sidi") @db.Date
  telepon                  String?             @db.VarChar(20)
  whatsapp                 String?             @db.VarChar(20)
  whatsappBolehDitampilkan Boolean             @default(false) @map("whatsapp_boleh_ditampilkan")
  email                    String?             @db.VarChar(100)
  pendidikanTerakhir       String?             @map("pendidikan_terakhir") @db.VarChar(50)
  pekerjaan                String?             @db.VarChar(100)
  alamatKtp                String?             @map("alamat_ktp") @db.Text
  alamatDomisili           String?             @map("alamat_domisili") @db.Text
  latitude                 Float?
  longitude                Float?
  dataStatus               DataStatus          @default(DRAFT) @map("data_status")
  catatan                  String?             @db.Text
  // ── PDP compliance ─────────────────────────────────────────
  konsenPDP                Boolean             @default(false) @map("konsen_pdp")
  tanggalKonsen            DateTime?           @map("tanggal_konsen")
  retensiHingga            DateTime?           @map("retensi_hingga") // hapus setelah tanggal ini
  createdBy                Int?                @map("created_by")
  updatedBy                Int?                @map("updated_by")
  validatedBy              Int?                @map("validated_by")
  validatedAt              DateTime?           @map("validated_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  keluarga               Keluarga?     @relation(fields: [keluargaId], references: [id])
  createdByUser          User?         @relation("WargaCreatedBy", fields: [createdBy], references: [id])
  updatedByUser          User?         @relation("WargaUpdatedBy", fields: [updatedBy], references: [id])
  validatedByUser        User?         @relation("WargaValidatedBy", fields: [validatedBy], references: [id])
  kelompokSebagaiPenatua Kelompok[]    @relation("KelompokPenatua")
  keluargaSebagaiKepala  Keluarga[]    @relation("KeluargaKepala")
  perpindahans           Perpindahan[] @relation("WargaPerpindahan")
  user                   User?         @relation("WargaUser")

  @@index([keluargaId])
  @@index([namaLengkap])
  @@index([nomorInduk])
  @@index([statusKeanggotaan])
  @@index([dataStatus])
  @@map("warga")
}

// ============================================================
// PERPINDAHAN
// ============================================================

model Perpindahan {
  id                 Int              @id @default(autoincrement())
  wargaId            Int              @map("warga_id")
  jenis              JenisPerpindahan
  gerejaAsalTujuan   String?          @map("gereja_asal_tujuan") @db.VarChar(200)
  tanggalPerpindahan DateTime?        @map("tanggal_perpindahan") @db.Date
  nomorSurat         String?          @map("nomor_surat") @db.VarChar(50)
  approvedBy         Int?             @map("approved_by")
  approvedAt         DateTime?        @map("approved_at")
  validatedBy        Int?             @map("validated_by")
  validatedAt        DateTime?        @map("validated_at")
  keterangan         String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")

  warga           Warga @relation("WargaPerpindahan", fields: [wargaId], references: [id])
  approvedByUser  User? @relation("PerpindahanApprovedBy", fields: [approvedBy], references: [id])
  validatedByUser User? @relation("PerpindahanValidatedBy", fields: [validatedBy], references: [id])

  @@map("perpindahan")
}

// ============================================================
// USERS & ACCESS
// ============================================================

model User {
  id                 Int       @id @default(autoincrement())
  wargaId            Int?      @unique @map("warga_id")
  nama               String    @db.VarChar(150)
  username           String    @unique @db.VarChar(50)
  email              String    @unique @db.VarChar(100)
  whatsapp           String?   @db.VarChar(20)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  resetTokenHash     String?   @map("reset_token_hash")
  resetTokenExpiry   DateTime? @map("reset_token_expiry")
  role               UserRole
  kelompokId         Int?      @map("kelompok_id")
  aktif              Boolean   @default(true)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLogin          DateTime? @map("last_login")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  warga                Warga?        @relation("WargaUser", fields: [wargaId], references: [id])
  kelompok             Kelompok?     @relation(fields: [kelompokId], references: [id])
  auditLogs            AuditLog[]
  importLogs           ImportLog[]
  keluargasCreated     Keluarga[]    @relation("KeluargaCreatedBy")
  keluargasUpdated     Keluarga[]    @relation("KeluargaUpdatedBy")
  wargasCreated        Warga[]       @relation("WargaCreatedBy")
  wargasUpdated        Warga[]       @relation("WargaUpdatedBy")
  wargasValidated      Warga[]       @relation("WargaValidatedBy")
  perpindahanApproved  Perpindahan[] @relation("PerpindahanApprovedBy")
  perpindahanValidated Perpindahan[] @relation("PerpindahanValidatedBy")

  @@map("users")
}

// ============================================================
// AUDIT & IMPORT LOG
// ============================================================

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  userId    Int?        @map("user_id")
  action    AuditAction
  tabel     String      @db.VarChar(50)
  recordId  Int         @map("record_id")
  dataLama  Json?       @map("data_lama")
  dataBaru  Json?       @map("data_baru")
  ipAddress String?     @map("ip_address") @db.VarChar(45)
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([tabel, recordId])
  @@index([userId])
  @@map("audit_log")
}

model ImportLog {
  id           Int          @id @default(autoincrement())
  userId       Int?         @map("user_id")
  filename     String       @db.VarChar(255)
  totalRows    Int?         @map("total_rows")
  successCount Int          @default(0) @map("success_count")
  errorCount   Int          @default(0) @map("error_count")
  errorDetail  Json?        @map("error_detail")
  status       ImportStatus @default(PROCESSING)
  createdAt    DateTime     @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("import_log")
}

// ============================================================
// ENUMS
// ============================================================

enum StatusKeluarga {
  AKTIF
  NON_AKTIF

  @@map("status_keluarga_enum")
}

enum DataStatus {
  DRAFT
  VALIDASI
  AKTIF
  TIDAK_AKTIF

  @@map("data_status_enum")
}

enum JenisKelamin {
  L
  P

  @@map("jenis_kelamin_enum")
}

enum GolonganDarah {
  A
  B
  AB
  O

  @@map("golongan_darah_enum")
}

enum StatusDalamKeluarga {
  KEPALA
  ISTRI
  ANAK
  MENANTU
  CUCU
  LAINNYA

  @@map("status_dalam_keluarga_enum")
}

enum StatusKeanggotaan {
  AKTIF
  NON_AKTIF
  KATEKUMEN
  PINDAH_KELUAR
  MENINGGAL

  @@map("status_keanggotaan_enum")
}

enum JenisPerpindahan {
  MASUK
  KELUAR
  MENINGGAL

  @@map("jenis_perpindahan_enum")
}

enum UserRole {
  SUPERADMIN
  KEPALA_KANTOR
  MAJELIS
  STAF_ADMIN
  PENATUA_KELOMPOK
  VIEWER

  @@map("user_role_enum")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  VALIDATE
  IMPORT
  ACCESS // baca data pribadi sensitif — PDP audit trail

  @@map("audit_action_enum")
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("import_status_enum")
}

// ============================================================
// NOTIFIKASI AKUN & KONTAK GEREJA
// ============================================================

model TemplatePesan {
  id        Int      @id @default(autoincrement())
  kode      String   @unique @db.VarChar(40)
  nama      String   @db.VarChar(100)
  isi       String   @db.Text
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("template_pesan")
}

model NotifikasiLog {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  templateKode String   @map("template_kode") @db.VarChar(40)
  nomorMasker  String   @map("nomor_masker") @db.VarChar(30)
  pesanMasker  String   @map("pesan_masker") @db.Text
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifikasi_log")
}

model KontakGereja {
  id         Int               @id @default(autoincrement())
  jenis      JenisKontakGereja
  nama       String            @db.VarChar(150)
  whatsapp   String            @db.VarChar(20)
  keterangan String?           @db.VarChar(150)
  aktif      Boolean           @default(true)
  urutan     Int               @default(0)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@map("kontak_gereja")
}

enum JenisKontakGereja {
  WA_CENTER
  KEPALA_KANTOR
  PENDETA
  PENDETA_EMERITUS

  @@map("jenis_kontak_gereja_enum")
}
