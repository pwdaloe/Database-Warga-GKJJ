# Salin ke /var/www/gkjj/apps/kegiatan-api/.env (JANGAN commit hasilnya) lalu ganti setiap nilai placeholder.
# Database TERPISAH dari aplikasi jemaat, dengan pengguna DB sendiri.
DATABASE_URL="postgresql://gkjj_kegiatan:GANTI_PASSWORD_DB@localhost:5432/gkjj_kegiatan"

PORT=4200
NODE_ENV=production

# Acak panjang, BERBEDA dari JWT_SECRET aplikasi jemaat:  openssl rand -hex 32
JWT_SECRET="GANTI"
JWT_EXPIRES_IN="12h"

# Web dan API satu domain (API di jalur /api), jadi asalnya sama
CORS_ORIGIN="https://kegiatan.gkjjakarta.org"
APP_URL="https://kegiatan.gkjjakarta.org"

# Password awal akun admin untuk `npm run db:seed` (minimal 12 karakter). Hapus baris ini setelah seed pertama.
SEED_ADMIN_PASSWORD="GANTI_MINIMAL_12_KARAKTER"
